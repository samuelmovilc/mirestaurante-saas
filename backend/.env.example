# ============================================================
# MiRestaurante SaaS — Variables de entorno
# Copia este archivo como .env y completa los valores reales
# NUNCA subas .env a GitHub
# ============================================================

# Puerto del servidor (3010 asignado en Contabo)
PORT=3010

# Base de datos MAESTRA (donde viven los tenants)
# Usa el MariaDB del puerto 3308 (mismo ecosistema Vercel)
DB_MASTER_HOST=127.0.0.1
DB_MASTER_PORT=3308
DB_MASTER_USER=saas_user
DB_MASTER_PASSWORD=TU_PASSWORD_AQUI
DB_MASTER_NAME=mirestaurante_saas

# JWT Secret para tokens de cada tenant
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRET_LARGO_Y_ALEATORIO

# JWT Secret para el panel admin SaaS (superadmin)
SAAS_ADMIN_SECRET=CAMBIA_ESTO_POR_OTRO_SECRET_DIFERENTE

# Password del superadmin del panel SaaS
SAAS_ADMIN_PASSWORD=DEFINE_TU_PASSWORD_AQUI

# CORS — URL del frontend en Vercel (actualizar tras deploy)
CORS_ORIGIN=https://mirestaurante.vercel.app

# Entorno
NODE_ENV=production
